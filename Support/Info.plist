<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSHomeKitUsageDescription</key>
  <string>Home Sensors reads battery levels and sensor readings from your accessories to show them on its dashboard. It does not change your accessories.</string>
  <key>NSLocalNetworkUsageDescription</key>
  <string>Home Sensors serves its dashboard as a web page to phones and computers on your local network.</string>
  <key>HomeSensorsAllowedHosts</key>
  <string>$(HOME_SENSORS_ALLOWED_HOSTS)</string>
  <!-- One window only. The window can't be closed or minimized, so only Quit could remove a second one. -->
  <key>UIApplicationSceneManifest</key>
  <dict>
    <key>UIApplicationSupportsMultipleScenes</key>
    <false/>
  </dict>
</dict>
</plist>
